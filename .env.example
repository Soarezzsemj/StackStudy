# Copie para `.env` (nunca faça commit dele): cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=stackstudy
POSTGRES_USER=stackstudy
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# URL JDBC do backend (no docker compose o host é `postgres`)
DB_URL=jdbc:postgresql://postgres:5432/stackstudy
DB_USERNAME=stackstudy
DB_PASSWORD=change-me
# Segredo para assinar o JWT, com pelo menos 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
# Durações no formato ISO-8601
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D
# Origens permitidas, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Cookie do refresh token (Secure precisa ser true em produção / HTTPS)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
# Dados de demonstração no boot (só perfil dev; nunca em prod): demo@stackstudy.local / demo-password
SEED_DEMO=false
# Painel do admin (/admin/status): e-mails, separados por vírgula, de contas que JÁ existem.
# Crie a conta primeiro; o papel ADMIN é aplicado na próxima inicialização do backend.
ADMIN_EMAILS=
# Links opcionais para os painéis dos provedores (https://...)
ADMIN_LINK_RENDER=
ADMIN_LINK_NEON=
ADMIN_LINK_VERCEL=
ADMIN_LINK_BACKUP=

# --- Frontend ---
FRONTEND_PORT=5173
# Para onde o Vite repassa /api (no docker compose: http://backend:8080)
VITE_API_PROXY_TARGET=http://backend:8080
# Base da API no navegador; padrão /api (mesma origem: proxy do Vite em dev, rewrite da Vercel em prod)
VITE_API_URL=/api
# Opcional: URL para acordar o backend no carregamento (em prod: https://<servico>.onrender.com/actuator/health/liveness)
VITE_WAKE_URL=

# --- Produção (Render + Neon) ---
# Não preencha aqui: estas variáveis vão no painel do Render. Ver DEPLOY.md.
# DATABASE_URL, DATABASE_DIRECT_URL, DATABASE_USERNAME, DATABASE_PASSWORD, JWT_SECRET,
# ALLOWED_ORIGINS, SWAGGER_ENABLED, DB_POOL_MAX, JVM_MAX_HEAP, JAVA_OPTS, JAVA_TOOL_OPTIONS
